{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Apart": {
      "additionalProperties": false,
      "description": "The two resources should not work the same task.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "confirmed"
          ],
          "title": "Status",
          "type": "string"
        },
        "hardness": {
          "enum": [
            "hard",
            "soft"
          ],
          "title": "Hardness",
          "type": "string"
        },
        "weight": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        },
        "template": {
          "const": "apart",
          "title": "Template",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/ResourcePairParams"
        }
      },
      "required": [
        "id",
        "rationale",
        "provenance",
        "hardness",
        "template",
        "params"
      ],
      "title": "Apart",
      "type": "object"
    },
    "Assumption": {
      "additionalProperties": false,
      "description": "Something the agent assumed and still needs to confirm.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "status": {
          "enum": [
            "proposed",
            "confirmed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "status"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "AttributeBinding": {
      "additionalProperties": false,
      "description": "Maps one CSV column to a typed attribute.",
      "properties": {
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "type": {
          "enum": [
            "str",
            "int",
            "float",
            "bool",
            "list"
          ],
          "title": "Type",
          "type": "string"
        },
        "separator": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Separator"
        }
      },
      "required": [
        "column",
        "type"
      ],
      "title": "AttributeBinding",
      "type": "object"
    },
    "Balance": {
      "additionalProperties": false,
      "description": "Minimize max - min of a measure over scoped resources, counting scoped tasks (soft only).",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "confirmed"
          ],
          "title": "Status",
          "type": "string"
        },
        "hardness": {
          "const": "soft",
          "title": "Hardness",
          "type": "string"
        },
        "weight": {
          "minimum": 1,
          "title": "Weight",
          "type": "integer"
        },
        "template": {
          "const": "balance",
          "title": "Template",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/BalanceParams"
        }
      },
      "required": [
        "id",
        "rationale",
        "provenance",
        "hardness",
        "weight",
        "template",
        "params"
      ],
      "title": "Balance",
      "type": "object"
    },
    "BalanceParams": {
      "additionalProperties": false,
      "properties": {
        "measure": {
          "enum": [
            "count",
            "hours"
          ],
          "title": "Measure",
          "type": "string"
        }
      },
      "required": [
        "measure"
      ],
      "title": "BalanceParams",
      "type": "object"
    },
    "BaselineAssignment": {
      "additionalProperties": false,
      "properties": {
        "task_id": {
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        },
        "resource_id": {
          "minLength": 1,
          "title": "Resource Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "resource_id"
      ],
      "title": "BaselineAssignment",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "description": "One filter ``{attribute, op, value}``; the conditions of a scope are combined with AND.",
      "properties": {
        "attribute": {
          "minLength": 1,
          "title": "Attribute",
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "in",
            "not_in",
            "contains",
            "gte",
            "lte"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "attribute",
        "op",
        "value"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "description": "Each in-scope task gets exactly ``demand`` resources (structural, hard only).",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "confirmed"
          ],
          "title": "Status",
          "type": "string"
        },
        "hardness": {
          "const": "hard",
          "title": "Hardness",
          "type": "string"
        },
        "template": {
          "const": "coverage",
          "title": "Template",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/NoParams"
        }
      },
      "required": [
        "id",
        "rationale",
        "provenance",
        "hardness",
        "template"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "DataBindings": {
      "additionalProperties": false,
      "description": "Where the resources and tasks of a DM come from.",
      "properties": {
        "resources": {
          "$ref": "#/$defs/ResourceBinding"
        },
        "tasks": {
          "$ref": "#/$defs/TaskBinding"
        }
      },
      "required": [
        "resources",
        "tasks"
      ],
      "title": "DataBindings",
      "type": "object"
    },
    "Horizon": {
      "additionalProperties": false,
      "description": "The planning period: ``start`` and ``end`` dates, both inclusive, at most 366 days.",
      "properties": {
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Horizon",
      "type": "object"
    },
    "MaxConsecutiveDays": {
      "additionalProperties": false,
      "description": "A resource works at most ``days`` consecutive days.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "confirmed"
          ],
          "title": "Status",
          "type": "string"
        },
        "hardness": {
          "enum": [
            "hard",
            "soft"
          ],
          "title": "Hardness",
          "type": "string"
        },
        "weight": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        },
        "template": {
          "const": "max_consecutive_days",
          "title": "Template",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/MaxConsecutiveDaysParams"
        }
      },
      "required": [
        "id",
        "rationale",
        "provenance",
        "hardness",
        "template",
        "params"
      ],
      "title": "MaxConsecutiveDays",
      "type": "object"
    },
    "MaxConsecutiveDaysParams": {
      "additionalProperties": false,
      "properties": {
        "days": {
          "minimum": 1,
          "title": "Days",
          "type": "integer"
        }
      },
      "required": [
        "days"
      ],
      "title": "MaxConsecutiveDaysParams",
      "type": "object"
    },
    "MaxPerPeriod": {
      "additionalProperties": false,
      "description": "Upper bound of a measure (count or hours) per resource per period.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "confirmed"
          ],
          "title": "Status",
          "type": "string"
        },
        "hardness": {
          "enum": [
            "hard",
            "soft"
          ],
          "title": "Hardness",
          "type": "string"
        },
        "weight": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        },
        "template": {
          "const": "max_per_period",
          "title": "Template",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/PeriodLimitParams"
        }
      },
      "required": [
        "id",
        "rationale",
        "provenance",
        "hardness",
        "template",
        "params"
      ],
      "title": "MaxPerPeriod",
      "type": "object"
    },
    "MinPerPeriod": {
      "additionalProperties": false,
      "description": "Lower bound of a measure (count or hours) per resource per period.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "confirmed"
          ],
          "title": "Status",
          "type": "string"
        },
        "hardness": {
          "enum": [
            "hard",
            "soft"
          ],
          "title": "Hardness",
          "type": "string"
        },
        "weight": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        },
        "template": {
          "const": "min_per_period",
          "title": "Template",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/PeriodLimitParams"
        }
      },
      "required": [
        "id",
        "rationale",
        "provenance",
        "hardness",
        "template",
        "params"
      ],
      "title": "MinPerPeriod",
      "type": "object"
    },
    "MinRest": {
      "additionalProperties": false,
      "description": "The gap between consecutive tasks of a resource is at least ``hours``.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "confirmed"
          ],
          "title": "Status",
          "type": "string"
        },
        "hardness": {
          "enum": [
            "hard",
            "soft"
          ],
          "title": "Hardness",
          "type": "string"
        },
        "weight": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        },
        "template": {
          "const": "min_rest",
          "title": "Template",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/MinRestParams"
        }
      },
      "required": [
        "id",
        "rationale",
        "provenance",
        "hardness",
        "template",
        "params"
      ],
      "title": "MinRest",
      "type": "object"
    },
    "MinRestParams": {
      "additionalProperties": false,
      "properties": {
        "hours": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "gt": 0,
          "title": "Hours"
        }
      },
      "required": [
        "hours"
      ],
      "title": "MinRestParams",
      "type": "object"
    },
    "NoOverlap": {
      "additionalProperties": false,
      "description": "A resource cannot work two time-overlapping tasks.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "confirmed"
          ],
          "title": "Status",
          "type": "string"
        },
        "hardness": {
          "enum": [
            "hard",
            "soft"
          ],
          "title": "Hardness",
          "type": "string"
        },
        "weight": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        },
        "template": {
          "const": "no_overlap",
          "title": "Template",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/NoParams"
        }
      },
      "required": [
        "id",
        "rationale",
        "provenance",
        "hardness",
        "template"
      ],
      "title": "NoOverlap",
      "type": "object"
    },
    "NoParams": {
      "additionalProperties": false,
      "description": "The template takes no parameters.",
      "properties": {},
      "title": "NoParams",
      "type": "object"
    },
    "PeriodLimitParams": {
      "additionalProperties": false,
      "properties": {
        "measure": {
          "enum": [
            "count",
            "hours"
          ],
          "title": "Measure",
          "type": "string"
        },
        "period": {
          "enum": [
            "day",
            "week",
            "horizon"
          ],
          "title": "Period",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "ge": 0,
          "title": "Limit"
        }
      },
      "required": [
        "measure",
        "period",
        "limit"
      ],
      "title": "PeriodLimitParams",
      "type": "object"
    },
    "Preference": {
      "additionalProperties": false,
      "description": "Scoped resources prefer or avoid scoped tasks (soft only).",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "confirmed"
          ],
          "title": "Status",
          "type": "string"
        },
        "hardness": {
          "const": "soft",
          "title": "Hardness",
          "type": "string"
        },
        "weight": {
          "minimum": 1,
          "title": "Weight",
          "type": "integer"
        },
        "template": {
          "const": "preference",
          "title": "Template",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/PreferenceParams"
        }
      },
      "required": [
        "id",
        "rationale",
        "provenance",
        "hardness",
        "weight",
        "template",
        "params"
      ],
      "title": "Preference",
      "type": "object"
    },
    "PreferenceParams": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "prefer",
            "avoid"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "PreferenceParams",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a rule came from: a user utterance, a data column, an assumption or a default.",
      "properties": {
        "kind": {
          "enum": [
            "utterance",
            "data",
            "assumption",
            "default"
          ],
          "title": "Kind",
          "type": "string"
        },
        "turn_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn Id"
        },
        "quote": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "source": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "RequiresAttribute": {
      "additionalProperties": false,
      "description": "A resource may work a task only if its attribute matches the task's requirement.\n\nTasks without the task attribute, or with an empty list, are unrestricted.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "confirmed"
          ],
          "title": "Status",
          "type": "string"
        },
        "hardness": {
          "enum": [
            "hard",
            "soft"
          ],
          "title": "Hardness",
          "type": "string"
        },
        "weight": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight"
        },
        "template": {
          "const": "requires_attribute",
          "title": "Template",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/RequiresAttributeParams"
        }
      },
      "required": [
        "id",
        "rationale",
        "provenance",
        "hardness",
        "template",
        "params"
      ],
      "title": "RequiresAttribute",
      "type": "object"
    },
    "RequiresAttributeParams": {
      "additionalProperties": false,
      "properties": {
        "task_attribute": {
          "minLength": 1,
          "title": "Task Attribute",
          "type": "string"
        },
        "resource_attribute": {
          "minLength": 1,
          "title": "Resource Attribute",
          "type": "string"
        },
        "match": {
          "enum": [
            "contains",
            "equals"
          ],
          "title": "Match",
          "type": "string"
        }
      },
      "required": [
        "task_attribute",
        "resource_attribute",
        "match"
      ],
      "title": "RequiresAttributeParams",
      "type": "object"
    },
    "ResourceBinding": {
      "additionalProperties": false,
      "description": "CSV binding for resources: id column plus typed attribute columns.",
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "attributes": {
          "additionalProperties": {
            "$ref": "#/$defs/AttributeBinding"
          },
          "title": "Attributes",
          "type": "object"
        }
      },
      "required": [
        "source",
        "id"
      ],
      "title": "ResourceBinding",
      "type": "object"
    },
    "ResourcePairParams": {
      "additionalProperties": false,
      "properties": {
        "resource_ids": {
          "items": {
            "minLength": 1,
