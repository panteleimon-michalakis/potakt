    },
    "timezone": {
      "title": "Timezone",
      "type": "string"
    },
    "horizon": {
      "$ref": "#/$defs/Horizon"
    },
    "data": {
      "$ref": "#/$defs/DataBindings"
    },
    "constraints": {
      "items": {
        "discriminator": {
          "mapping": {
            "apart": "#/$defs/Apart",
            "balance": "#/$defs/Balance",
            "coverage": "#/$defs/Coverage",
            "max_consecutive_days": "#/$defs/MaxConsecutiveDays",
            "max_per_period": "#/$defs/MaxPerPeriod",
            "min_per_period": "#/$defs/MinPerPeriod",
            "min_rest": "#/$defs/MinRest",
            "no_overlap": "#/$defs/NoOverlap",
            "preference": "#/$defs/Preference",
            "requires_attribute": "#/$defs/RequiresAttribute",
            "stability": "#/$defs/Stability",
            "together": "#/$defs/Together",
            "unavailable": "#/$defs/Unavailable"
          },
          "propertyName": "template"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/Coverage"
          },
          {
            "$ref": "#/$defs/RequiresAttribute"
          },
          {
            "$ref": "#/$defs/NoOverlap"
          },
          {
            "$ref": "#/$defs/MinRest"
          },
          {
            "$ref": "#/$defs/MaxPerPeriod"
          },
          {
            "$ref": "#/$defs/MinPerPeriod"
          },
          {
            "$ref": "#/$defs/MaxConsecutiveDays"
          },
          {
            "$ref": "#/$defs/Unavailable"
          },
          {
            "$ref": "#/$defs/Preference"
          },
          {
            "$ref": "#/$defs/Balance"
          },
          {
            "$ref": "#/$defs/Together"
          },
          {
            "$ref": "#/$defs/Apart"
          },
          {
            "$ref": "#/$defs/Stability"
          }
        ]
      },
      "minItems": 1,
      "title": "Constraints",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "$ref": "#/$defs/Assumption"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "objective": {
      "const": "lexicographic_hard_then_soft",
      "default": "lexicographic_hard_then_soft",
      "title": "Objective",
      "type": "string"
    }
