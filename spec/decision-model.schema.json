        "draft",
        "confirmed",
        "approved"
      ],
      "title": "Status",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "language": {
      "enum": [
        "en",
        "el"
      ],
      "title": "Language",
      "type": "string"
    },
    "archetype": {
      "const": "assignment",
      "title": "Archetype",
      "type": "string"
    },
    "vocabulary": {
