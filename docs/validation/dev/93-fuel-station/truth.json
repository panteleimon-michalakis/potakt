      "status": "confirmed"
    },
    {
      "id": "position-skill",
      "template": "requires_attribute",
      "hardness": "hard",
      "params": {
        "task_attribute": "position",
        "resource_attribute": "skills",
        "match": "contains"
      },
      "rationale": "Στο ταμείο μόνο όσοι έχουν τη δεξιότητα «ταμείο» και στις αντλίες μόνο όσοι έχουν τη δεξιότητα «αντλίες».",
      "provenance": {
        "kind": "utterance",
        "quote": "Στο ταμείο μπαίνει μόνο όποιος έχει μάθει το ταμείο, και στις αντλίες μόνο όποιος ξέρει τις αντλίες"
      },
      "status": "confirmed"
    },
    {
      "id": "leave-file",
      "template": "unavailable",
      "hardness": "hard",
      "params": {
        "source": {
          "source": "adeies.csv",
          "resource_id": "Κωδικός",
          "start": "Από",
          "end": "Έως",
